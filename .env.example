# Voice + decision pipeline. Every key is optional: with none, touch and emotes still work (rules decider).
# Speech (TTS) and Scribe v3 Live (STT)
ELEVENLABS_API_KEY=
# LLM that writes Mintie's lines
OPENROUTER_API_KEY=
# Any /v1/systemone endpoint; falls back to TYPESAFE_API_KEY
SYSTEM_ONE_API_KEY=
TYPESAFE_API_KEY=

# Swappable pieces (defaults shown; leave unset to use them)
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_BASE_URL=https://openrouter.ai/api/v1
# e.g. http://127.0.0.1:3000/v1/systemone for a local OpenJev (no key needed)
# SYSTEM_ONE_URL=https://api.typesafe.ai/v1/systemone
# SYSTEM_ONE_MODEL=
# ELEVENLABS_VOICE_ID=ocZQ262SsZb9RIxcQBOj
# ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# ELEVENLABS_STT_MODEL=scribe_v3_live
# SYSTEM_ONE_TIMEOUT_MS=800

# Optional Cloudflare deployment helper
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
